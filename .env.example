# Local development defaults to ./data/harness.sqlite. Set both values to use Turso.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Required on Vercel. Use an authenticated HTTPS gateway to Hugo; never expose Ollama directly.
MODEL_SERVER_URL=
MODEL_SERVER_TOKEN=

# Optional server default for Firecrawl web search. Users may supply their own
# key per tab in the app settings instead; that key is never persisted server-side.
FIRECRAWL_API_KEY=

# Hash of the private application access code. Generate with the documented helper.
APP_ACCESS_CODE_HASH=
APP_SESSION_SECRET=

# Optional model endpoint for background title generation. No endpoint is hardcoded.
TITLE_MODEL_SERVER_URL=

# Required for remote deployment; local development can remain unauthenticated on loopback.
CRON_SECRET=
