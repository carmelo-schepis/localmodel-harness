{
  "name": "local-harness",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "tsc -b && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "migrate:turso": "tsx scripts/migrate-to-turso.ts",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "11.2.0",
    "@fastify/multipart": "9.3.0",
    "@fastify/static": "^10.1.10",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@libsql/client": "^0.18.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@vercel/functions": "^3.11.0",
    "better-sqlite3": "12.0.0",
    "fastify": "5.12.8",
    "lucide-react": "0.468.0",
    "mammoth": "1.13.0",
    "papaparse": "5.5.3",
    "pdfjs-dist": "5.4.149",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@playwright/test": "^1.65.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.19.0",
    "@types/papaparse": "5.3.16",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "6.2.1",
    "concurrently": "^9.2.5",
    "eslint": "9.36.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.22",
    "globals": "16.4.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.36.0",
    "vite": "8.3.6",
    "vitest": "^3.2.7"
  }
}
